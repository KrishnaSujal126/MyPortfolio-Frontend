{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/index.html", "destination": "/frontend/index.html" },
    { "source": "/about.html", "destination": "/frontend/about.html" },
    { "source": "/about", "destination": "/frontend/about.html" },
    { "source": "/projects.html", "destination": "/frontend/projects.html" },
    { "source": "/projects", "destination": "/frontend/projects.html" },
    { "source": "/cv.html", "destination": "/frontend/cv.html" },
    { "source": "/cv", "destination": "/frontend/cv.html" },
    { "source": "/contact.html", "destination": "/frontend/contact.html" },
    { "source": "/contact", "destination": "/frontend/contact.html" },
    { "source": "/admin.html", "destination": "/frontend/admin.html" },
    { "source": "/admin", "destination": "/frontend/admin.html" },
    { "source": "/style.css", "destination": "/frontend/style.css" },
    { "source": "/script.js", "destination": "/frontend/script.js" },
    { "source": "/frontend-config.js", "destination": "/frontend/frontend-config.js" },
